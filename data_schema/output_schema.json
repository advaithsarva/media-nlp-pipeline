{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nlppipeline/output_schema.json",
  "title": "Analysis output record",
  "description": "What the backend receives for one document. Deliberately contains no wall-clock timestamp: the same input must produce a byte-identical record on every run, and a timestamp would break that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "source", "config_hashes", "stats", "findings", "category_scores", "composite", "notes"],
  "properties": {
    "schema_version": { "type": "string" },
    "document_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] }
      }
    },
    "config_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeline_hash", "taxonomy_hash", "scoring_hash"],
      "properties": {
        "pipeline_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "taxonomy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scoring_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["char_count", "word_count", "sentence_count"],
      "properties": {
        "char_count": { "type": "integer", "minimum": 0 },
        "word_count": { "type": "integer", "minimum": 0 },
        "sentence_count": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "description": "One entry per piece of evidence. 'text' is always an exact substring of the article at [start_char, end_char); never a paraphrase.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "rule_id", "sentence_id", "text", "start_char", "end_char", "confidence"],
        "properties": {
          "category": { "type": "string" },
          "rule_id": { "type": "string" },
          "sentence_id": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "start_char": { "type": "integer", "minimum": 0 },
          "end_char": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "category_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "raw", "score", "calibrated"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 },
          "raw": { "type": "number", "minimum": 0 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "calibrated": { "type": "boolean" }
        }
      }
    },
    "composite": {
      "type": ["number", "null"],
      "description": "Null until the detectors have measured precision against a labelled set."
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
